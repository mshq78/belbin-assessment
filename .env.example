# Neon Postgres (set automatically by the Vercel ↔ Neon integration)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Password for the admin panel (#/admin). Server-side only. Required.
ADMIN_PASSWORD="choose-a-strong-password"

# Optional: secret used to sign login tokens (defaults to a value derived from DATABASE_URL)
SESSION_SECRET=""
